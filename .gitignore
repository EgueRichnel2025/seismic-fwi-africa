!results/figures/*.gif
!results/figures/.gitkeep

# Vidéos de démonstration
!results/videos/
results/videos/*
!results/videos/*.mp4
!results/videos/.gitkeep

# Données numériques volumineuses
experiments/output/*
!experiments/output/.gitkeep
*.npy
*.npz
*.h5
*.hdf5

# Fichiers temporaires
*.tmp
*.log

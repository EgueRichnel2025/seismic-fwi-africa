# Python
__pycache__/
*.py[cod]
*.so

# Environnements virtuels
.venv/
venv/
env/

# Tests et couverture
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Construction et packaging
build/
dist/
*.egg-info/

# IDE
.vscode/
.idea/

# Système
.DS_Store
Thumbs.db

# Résultats scientifiques : exclus par défaut
results/*
